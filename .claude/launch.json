{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "samkirk-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "samkirk-web-e2e",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "E2E_TESTING=true NEXT_PUBLIC_E2E_TESTING=true npm run dev"
      ],
      "cwd": "web",
      "port": 3000
    }
  ]
}
